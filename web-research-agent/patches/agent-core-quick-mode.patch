+export function compactToolResultForModel(result: unknown, maxCharacters = 24_000): unknown {
+  let remaining = Math.max(maxCharacters, 1_000);
+  const seen = new WeakSet<object>();
+  const visit = (value: unknown): unknown => {
+    if (value == null || typeof value === "boolean" || typeof value === "number") {
+      remaining -= 16;
+      return value;
+    }
+    if (typeof value === "string") {
+      const limit = Math.max(0, remaining);
+      const output = value.length > limit ? `${value.slice(0, limit)}\n[truncated]` : value;
+      remaining -= output.length;
+      return output;
+    }
+    if (typeof value !== "object") return String(value);
+    if (seen.has(value)) return "[circular]";
+    seen.add(value);
+    if (Array.isArray(value)) {
+      const output: unknown[] = [];
+      for (const item of value) {
+        if (remaining <= 0 || output.length >= 20) break;
+        output.push(visit(item));
+      }
+      return output;
+    }
+    const output: Record<string, unknown> = {};
+    for (const key of Object.keys(value as object)) {
+      if (remaining <= 0 || Object.keys(output).length >= 50) break;
+      const descriptor = Object.getOwnPropertyDescriptor(value, key);
+      if (!descriptor || descriptor.get) continue;
+      remaining -= key.length;
+      output[key] = visit(descriptor.value);
+    }
+    return output;
+  };
+  return visit(result);
+}
