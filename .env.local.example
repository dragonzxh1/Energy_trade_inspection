# OpenSanctions API (commercial license required for SaaS use)
OPENSANCTIONS_API_KEY=your_key_here

# UK Companies House API (free, register at https://developer.companieshouse.gov.uk)
COMPANIES_HOUSE_API_KEY=your_key_here

# Database (Docker Postgres)
DATABASE_URL=postgresql://eti:eti_password@localhost:5432/energy_trade_inspection

# Stripe (Phase 1 payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_SECRET=replace_with_long_random_secret
SYNC_SECRET=replace_with_long_random_secret

# Dify / internal content pipeline
DIFY_BASE_URL=http://127.0.0.1
DIFY_API_KEY=app-...
DIFY_WORKFLOW_API_KEY=app-...
DIFY_WORKFLOW_API_KEY_EXTRACT=app-...
DIFY_WORKFLOW_API_KEY_AGGREGATE=app-...
DIFY_WORKFLOW_API_KEY_REVIEW=app-...
DIFY_WORKFLOW_API_KEY_WRITER=
DIFY_WORKFLOW_USER=telegram-ingest
DIFY_WORKFLOW_RESPONSE_MODE=blocking
DIFY_WORKFLOW_FILE_TYPE=document
MAX_TRANSLATED_EXCERPTS=3
MAX_TRANSLATION_SOURCE_CHARS=1200
MAX_REVIEW_EVIDENCE_CHARS=50000
DIFY_REVIEW_PASS_SCORE=85
ETI_INGEST_ENDPOINT=http://localhost:3000/api/internal/content/ingest
ETI_ADMIN_BEARER=replace_with_admin_secret
MARKET_PIPELINE_MODE=shadow
TELEGRAM_DIGITAL_CHAT=@platts_digits
TELEGRAM_SUMMARY_CHAT=@quotes_summary
TELEGRAM_DIGITAL_SESSION=/var/www/eti/Energy_trade_inspection/tmp/telegram/eti_telegram_digital
TELEGRAM_SUMMARY_SESSION=/var/www/eti/Energy_trade_inspection/tmp/telegram/eti_telegram_summary
TELEGRAM_DIGITAL_STATE=/var/www/eti/Energy_trade_inspection/tmp/telegram/state_platts-digits.json
TELEGRAM_SUMMARY_STATE=/var/www/eti/Energy_trade_inspection/tmp/telegram/state_quotes-summary.json
TELEGRAM_SUMMARY_SOURCE_CHANNEL=telegram:quotes-summary
TELEGRAM_DIGITAL_SOURCE_CHANNELS=telegram:platts-digits
TELEGRAM_SUMMARY_SOURCE_CHANNELS=telegram:quotes-summary
MARKET_PIPELINE_START_DATE=2026-07-25
SUMMARY_IMAGE_LOOKBACK_DAYS=14
SUMMARY_IMAGE_MAX_IMAGES=20
SUMMARY_IMAGE_START_DATE=
DIGIT_PUBLISH_LOOKBACK_DAYS=14
DIGIT_PUBLISH_MAX_DATES=10
DIGIT_PUBLISH_START_DATE=
MARKET_PIPELINE_LOOKBACK_DAYS=2
MARKET_PIPELINE_VERSION=telegram-input.v1
MARKET_PARSED_TEXT_DIR=/var/www/eti/obsidian-vault/market-pipeline/parsed-text
COMMODITY_KNOWLEDGE_OBSIDIAN_DIR=/var/www/eti/obsidian-vault/04_Commodity_Knowledge
DIFY_DATASET_API_KEY=
DIFY_DATASET_ID_COMMODITY_FRAMEWORKS=
DIFY_DATASET_ID_MARKET_EVENTS=
DIFY_DATASET_ID_EDITORIAL_HISTORY=
DIFY_DATASET_ID_RAW_DOCUMENTS=
MARKET_FACT_MAX_SECTIONS=100
MARKET_FACT_MAX_SECTIONS_PER_DOCUMENT=10
MARKET_FACT_MIN_DOCUMENT_COVERAGE=0.8
MARKET_DOCUMENT_BATCH_LIMIT=20
MARKET_FACT_BATCH_LIMIT=5

# WeChat Official Account publishing
WECHAT_MP_CONFIG=intelligence/wechat_publish.json
WECHAT_MP_ACCOUNT_ID=
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MP_AUTHOR=ETI
WECHAT_MP_CONTENT_SOURCE_URL=
WECHAT_MP_DEFAULT_THUMB_MEDIA_ID=
WECHAT_MP_THUMB_IMAGE_PATH=
WECHAT_MP_AUTO_GENERATE_THUMB=1
WECHAT_MP_THUMB_UPLOAD_TYPE=image
WECHAT_MP_SHADOW_PUBLISH_DAYS=3
WECHAT_MP_NEED_OPEN_COMMENT=0
WECHAT_MP_ONLY_FANS_CAN_COMMENT=0
WECHAT_MP_AUTO_MODE=off
WECHAT_MP_PUBLISH_POLL_SECONDS=8
WECHAT_MP_PUBLISH_POLL_ATTEMPTS=15

# Telegram personal-account collector
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=telegram_api_hash
TELEGRAM_SOURCE_CHAT=@your_source_chat
TELEGRAM_SESSION_FILE=tmp/telegram/eti_telegram
TELEGRAM_DOWNLOAD_DIR=tmp/telegram/raw
TELEGRAM_STATE_FILE=tmp/telegram/state.json
TELEGRAM_POLL_LIMIT=100
TELEGRAM_POLL_INTERVAL=120

# Daily FuelSight price capture
FUELSIGHT_BOT_USERNAME=@fuelsightbot
FUELSIGHT_COMMAND_TIMEOUT_SECONDS=30
FUELSIGHT_MAX_ATTEMPTS=2
DAILY_PRICE_MODE=shadow
# Shared by FuelSight capture, OCR promotion, daily reconciliation and WeChat release gate.
# Production example: /var/www/eti/obsidian-vault/reports/prices
DAILY_PRICE_ROOT=/var/www/eti/obsidian-vault/reports/prices
WECHAT_OFFICIAL_QR_PATH=/var/lib/eti/assets/wechat-official-qr.jpg

# External research and editorial style pipeline
FIRECRAWL_API_KEY=
FIRECRAWL_AGENT_BASE_URL=http://127.0.0.1:4318
DEEPSEEK_FLASH_AGENT_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DIFY_FLASH_MODEL_NAME=deepseek-v4-flash
DIFY_WORKFLOW_API_KEY_REVIEW_REPAIR=
EXTERNAL_RESEARCH_MODE=off
EXTERNAL_RESEARCH_MAX_QUERIES=12
EXTERNAL_RESEARCH_MAX_PAGES=30

# Email (Resend) — required for email/password auth
RESEND_API_KEY=re_...
FROM_EMAIL=ETI <noreply@yourdomain.com>
